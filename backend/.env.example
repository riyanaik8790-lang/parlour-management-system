# Backend Environment Variables Template
# Create a .env file locally for development or add these directly in the Render dashboard.

# In production, use the DATABASE_URL provided by PlanetScale / Aiven
DATABASE_URL="mysql://user:password@host:3306/dbname"

# Generate a strong, random secret key for production
JWT_SECRET="replace-me-with-a-very-long-secure-random-string"

# Allow CORS for your production frontend domain on Vercel
CORS_ORIGINS="https://parlour-management-system.vercel.app"
