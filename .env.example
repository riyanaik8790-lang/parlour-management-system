# Frontend Environment Variables Template
# Vercel will inject these automatically in production.
# For local dev, rename this file to .env.local

# Replace this with the URL of your deployed Python backend on Render
VITE_API_BASE_URL="https://your-backend-url.onrender.com"

# VAPID public key for Web Push (generated once — same value as backend VAPID_PUBLIC_KEY)
# Get this from your backend team or generate with: python backend/generate_vapid_keys.py
VITE_VAPID_PUBLIC_KEY="your-vapid-public-key-here"
